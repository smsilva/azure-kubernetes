#!/bin/bash
set -e

export THIS_SCRIPT_NAME=$0
export THIS_SCRIPT_DIRECTORY=$(dirname $0)
export PATH=${PATH}:${THIS_SCRIPT_DIRECTORY}

show_usage() {
  cat <<EOF

  Creates (or updates) a Federated Identity Credential on an App Registration,
  so a CI platform can authenticate to Azure with a short-lived OIDC token
  instead of a client secret.

  The issuer and the subject describe WHERE the pipeline runs. Pass them
  directly to support any platform, or use --provider for the two shorthands
  this repository knows about.

  Idempotent: an existing credential with the same name is updated in place.

  Options:

    -h,  --help          Show this help
    -c,  --client-id     App Registration Application (client) ID (default: \${ARM_CLIENT_ID})
    -n,  --name          Credential name (default: derived from provider and scope)
    -p,  --provider      github | gitlab (omit when using --issuer/--subject)
    -r,  --repository    Repository path, e.g. smsilva/azure-kubernetes
    -e,  --environment   Deployment environment the credential is bound to
    -b,  --branch        Branch the credential is bound to (ignored when --environment is given)
    -i,  --issuer        OIDC issuer URL (overrides --provider)
    -s,  --subject       OIDC subject claim (overrides --provider)
    -a,  --audience      Token audience (default: api://AzureADTokenExchange)
    -dr, --dry-run       Print what would be done (default: false)

  Examples:

    ${THIS_SCRIPT_NAME} \\
      --provider github \\
      --repository smsilva/azure-kubernetes \\
      --environment azure-sandbox

    ${THIS_SCRIPT_NAME} \\
      --provider github \\
      --repository smsilva/azure-kubernetes \\
      --branch main

    ${THIS_SCRIPT_NAME} \\
      --issuer https://vstoken.dev.azure.com/00000000-0000-0000-0000-000000000000 \\
      --subject sc://smsilva/azure-platform/azure-sandbox \\
      --name azure-devops-azure-sandbox

EOF
}

while [[ "$1" =~ ^- && ! "$1" == "--" ]]; do
case $1 in
  -h | --help )
    show_usage
    exit
    ;;

  -c | --client-id )
    shift; ARM_CLIENT_ID=$1
    ;;

  -n | --name )
    shift; credential_name=$1
    ;;

  -p | --provider )
    shift; provider=$1
    ;;

  -r | --repository )
    shift; repository=$1
    ;;

  -e | --environment )
    shift; environment=$1
    ;;

  -b | --branch )
    shift; branch=$1
    ;;

  -i | --issuer )
    shift; issuer=$1
    ;;

  -s | --subject )
    shift; subject=$1
    ;;

  -a | --audience )
    shift; audience=$1
    ;;

  -dr | --dry-run )
    if [[ -n "${2}" && "${2}" =~ ^(true|false)$ ]]; then
      dry_run="${2}"; shift
    else
      dry_run=true
    fi
    ;;

  * )
    echo "Invalid option: ${1}"
    show_usage
    exit 1
    ;;
esac; shift; done

if [[ "$1" == '--' ]]; then shift; fi

dry_run="${dry_run:-false}"
audience="${audience:-api://AzureADTokenExchange}"

if [ -z "${ARM_CLIENT_ID}" ]; then
  echo "Missing --client-id (or ARM_CLIENT_ID)."
  show_usage
  exit 1
fi

# Derive issuer and subject from the provider shorthand, when not given.
if [ -z "${issuer}" ] || [ -z "${subject}" ]; then
  if [ -z "${provider}" ]; then
    echo "Provide either --provider, or both --issuer and --subject."
    show_usage
    exit 1
  fi

  if [ -z "${repository}" ]; then
    echo "--repository is required with --provider ${provider}."
    exit 1
  fi

  if [ -z "${environment}" ] && [ -z "${branch}" ]; then
    echo "Provide --environment or --branch with --provider ${provider}."
    exit 1
  fi

  case "${provider}" in
    github )
      issuer="https://token.actions.githubusercontent.com"

      if [ -n "${environment}" ]; then
        subject="repo:${repository}:environment:${environment}"
      else
        subject="repo:${repository}:ref:refs/heads/${branch}"
      fi
      ;;

    gitlab )
      issuer="https://gitlab.com"

      if [ -n "${environment}" ]; then
        subject="project_path:${repository}:environment:${environment}"
      else
        subject="project_path:${repository}:ref_type:branch:ref:${branch}"
      fi
      ;;

    * )
      echo "Unknown provider: ${provider}. Use --issuer and --subject instead."
      exit 1
      ;;
  esac
fi

if [ -z "${credential_name}" ]; then
  credential_name="${provider:-oidc}-${environment:-${branch}}"
fi

echo "App Registration..: ${ARM_CLIENT_ID}"
echo "Credential Name...: ${credential_name}"
echo "Issuer............: ${issuer}"
echo "Subject...........: ${subject}"
echo "Audience..........: ${audience}"

parameters=$(cat <<EOF
{
  "name": "${credential_name}",
  "issuer": "${issuer}",
  "subject": "${subject}",
  "audiences": ["${audience}"]
}
EOF
)

existing_subject=$(az ad app federated-credential list \
  --id "${ARM_CLIENT_ID}" \
  --query "[?name=='${credential_name}'].subject | [0]" \
  --output tsv)

if [ "${existing_subject}" == "${subject}" ]; then
  echo "Already configured. Nothing to do."
  exit 0
fi

if [ "${dry_run}" == "true" ]; then
  if [ -n "${existing_subject}" ]; then
    echo "Dry Run: would update the credential (current subject: ${existing_subject})."
  else
    echo "Dry Run: would create the credential."
  fi

  exit 0
fi

if [ -n "${existing_subject}" ]; then
  echo "Updating (current subject: ${existing_subject})."

  az ad app federated-credential update \
    --id "${ARM_CLIENT_ID}" \
    --federated-credential-id "${credential_name}" \
    --parameters "${parameters}" \
    --output jsonc

  exit 0
fi

az ad app federated-credential create \
  --id "${ARM_CLIENT_ID}" \
  --parameters "${parameters}" \
  --output jsonc
