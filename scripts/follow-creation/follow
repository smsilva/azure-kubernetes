#!/bin/bash
this_script_directory="${0%/*}"
PATH="${PATH}:${this_script_directory}"

environment_id="${1}"

if [ -z "${environment_id}" ]; then
  echo "Please inform Environment ID."
  exit 1
fi

export EXECUTION_CACHE_FILE=$(mktemp)
trap 'rm -f "${EXECUTION_CACHE_FILE}"' EXIT

wait_until() {
  local description="${1}"; shift
  local sleep_seconds="${1}"; shift
  local max_attempts="${1}"; shift
  local clear_screen="${1}"; shift

  local attempt=1

  while ! "$@"; do
    if [ "${attempt}" -ge "${max_attempts}" ]; then
      echo "Timed out waiting for: ${description} (${attempt} attempts, ${sleep_seconds}s interval)"
      exit 1
    fi

    attempt=$((attempt + 1))
    sleep "${sleep_seconds}"

    if [ "${clear_screen}" == "true" ]; then
      clear
    fi
  done
}

wait_until "Resource Group" 10 30 true \
  resource-groups "${environment_id}"
echo ""

wait_until "AKS" 30 60 true \
  aks "${environment_id}"
echo ""

wait_until "Namespaces cert-manager|external-secrets" 10 30 true \
  namespaces "cert-manager|external-secrets" 2
echo ""

wait_until "ClusterIssuer selfsigned" 10 30 true \
  check-cluster-issuers "selfsigned" 1
echo ""

wait_until "ClusterIssuers Let's Encrypt" 10 60 true \
  check-cluster-issuers "letsencrypt" 6
echo ""

wait_until "Namespaces external-secrets" 10 30 true \
  namespaces "external-secrets" 1
echo ""

wait_until "external-secrets ClusterSecretStore" 10 30 true \
  external-secrets-secret-store
echo ""

wait_until "Namespaces ingress" 10 30 true \
  namespaces "ingress" 1
echo ""

wait_until "Namespaces argocd" 10 30 true \
  namespaces "argocd" 1
echo ""

wait_until "argo-cd pods running" 20 45 false \
  argocd-pods-running 7
echo ""

wait_until "external-secrets ExternalSecret" 10 30 true \
  external-secrets 5
echo ""

argocd_host="$(argocd-host)"

wait_until "argo-cd DNS check" 15 40 false \
  check-dns "${argocd_host}"
echo ""

wait_until "argo-cd Certificate check" 15 40 true \
  check-certificates "ingress-wildcard" 1
echo ""

wait_until "argo-cd curl check" 15 40 false \
  check-curl-wait "${argocd_host}"
echo ""
